# Server-only configuration. Never expose these values in frontend bundles.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:4000
TRUST_PROXY=false
DATABASE_URL=postgresql://nexus_user:change_me@localhost:5432/nexus
DATABASE_SSL=false
# 32-byte base64 key for AES-256-GCM encryption. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Isolated browser worker: use a random 32+ byte secret and a private SSRF-filtering egress proxy.
BROWSER_WORKER_TOKEN=
BROWSER_EGRESS_PROXY=
BROWSER_WORKER_HOST=127.0.0.1
BROWSER_WORKER_PORT=4002
